{
  "name": "masar-time",
  "productName": "Masar Time",
  "version": "2.0.0",
  "description": "برنامج الحضور والانصراف — نسخة سطح المكتب",
  "main": "main.js",
  "scripts": {
    "build:ui": "node tools/build-ui.mjs",
    "start": "npm run build:ui && electron .",
    "demo": "npm run build:ui && electron . --demo",
    "preview": "node tools/preview-server.js",
    "dist": "npm run build:ui && electron-builder --win dir --x64 && cd installer && makensis -DVERSION=$npm_package_version installer.nsi"
  },
  "dependencies": {
    "node-zklib": "^1.3.0",
    "sql.js": "^1.10.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "lucide-static": "^0.544.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  },
  "build": {
    "appId": "sa.masar.time",
    "productName": "Masar Time",
    "copyright": "Masar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "demo/**",
      "trial-build.json",
      "!tools/**",
      "!preview-data/**"
    ],
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Masar Time",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025",
      "artifactName": "Masar-Time-Setup-${version}.exe"
    }
  }
}
