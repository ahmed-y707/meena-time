{
  "name": "masar-time-school",
  "productName": "Masar Time School",
  "version": "1.0.3",
  "description": "Masar Time — school edition: live device punches, guardian SMS + WhatsApp",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "preview": "node tools/preview-server.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "node-zklib": "^1.3.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.10.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.msar.time.school",
    "productName": "Masar Time School",
    "copyright": "Meena",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "demo/**",
      "trial-build.json",
      "!tools/**",
      "!preview-data/**"
    ],
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meena Time",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025",
      "artifactName": "Meena-Time-Setup-${version}.exe"
    }
  }
}
